\frametitle{产品线全景图}
\centering
  % TODO: 用 TikZ 绘制产品矩阵图（使用 relative positioning）
  \begin{tikzpicture}[scale=0.7,
    node distance=1.8cm and 2.5cm,
  ]
    % 物理层
    \node[prodBoxR] (phy) {% TODO: Retimer\\产品线};

    % 交换层
    \node[prodBox, below right=of phy] (sw) {% TODO: 交换芯片\\产品线};

    % 内存层
    \node[prodBoxG, below=of sw] (mem) {% TODO: 内存控制器\\产品线};

    % 线缆/模块
    \node[prodBoxO, right=of sw] (cable) {% TODO: 智能线缆\\产品线};

    % 软件
    \node[prodBox, fill=gray!10, above=of sw] (software) {% TODO: 软件/遥测\\产品线};

    % TODO: 绘制连接箭头
    \draw[linkArrow] (phy) -- (sw);
    \draw[linkArrow] (sw) -- (mem);
  \end{tikzpicture}
